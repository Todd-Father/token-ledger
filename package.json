{
  "name": "token-ledger",
  "version": "1.0.0",
  "description": "A self-hosted dashboard for Claude API token usage, cost, per-project breakdown, and efficiency recommendations — powered by the Anthropic Usage & Cost Admin API.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "fetch": "node scripts/fetch-usage.mjs",
    "fetch:fixture": "node scripts/fetch-usage.mjs --fixture",
    "fixture:gen": "node scripts/gen-fixture.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/fetch-usage.mjs && node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "anthropic",
    "llm",
    "usage",
    "cost",
    "dashboard",
    "finops",
    "token",
    "prompt-caching"
  ]
}
