# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# THIS FILE IS ONLY NEEDED FOR THE CLAUDE API (organization) SOURCE.
# If you use Claude Code, skip it entirely — the dashboard reads your local
# sessions from ~/.claude/projects with no key and no configuration.
#
# The Usage & Cost API needs an ADMIN key (starts with sk-ant-admin01-...),
# which is different from a normal API key and is ONLY available to
# ORGANIZATION accounts. Individual accounts must first create an org:
#   Claude Console -> Settings -> Organization  (free; does not change billing)
# Then create an Admin key:
#   Console -> Settings -> Admin keys
#
# With no key set, the fetch uses your local Claude Code sessions if present,
# otherwise the bundled sample fixture — either way the dashboard still works.
#
# Running via npx? Put this file in ~/.token-ledger/ instead (or set
# LEDGER_HOME to wherever you want data and config to live).

ANTHROPIC_ADMIN_KEY=

# Optional: how many days back to pull. Default 90. Windows over 31 days are
# fetched automatically in 31-day chunks (the API's per-request cap).
LEDGER_DAYS=90

# Optional: absolute daily spend alert. If any day's cost exceeds this many
# dollars, the fetch warns and (on macOS) fires a notification. The
# 3x-trailing-average spike alert runs regardless. On Claude Code data both
# alerts run against the list-price estimate.
# LEDGER_ALERT_USD=5
